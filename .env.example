# URL реального бэкенда ШартномаЁр — БЕЗ /api/v1 в конце, клиент добавляет его сам.
# Локально (dotnet run в Backend/WebApi, профиль "http"): http://localhost:5292
# Локально с HTTPS (профиль "https"):                     https://localhost:7102
# Оставьте пустым, чтобы приложение работало в демо-режиме (localStorage, без сервера).
VITE_API_URL=

# Включает подробные логи API-клиента в консоли браузера (true/false).
VITE_API_DEBUG=false
